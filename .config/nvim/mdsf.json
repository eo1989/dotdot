{
  "$schema": "https://raw.githubusercontent.com/hougesen/mdsf/main/schemas/v0.11.0/mdsf.schema.json",
  "languages": {
    "c": "clang-format",
    "cpp": "clang-format",
    "json": ["biome:lint", "biome:check", ["biome:format", "prettier"]],
    "jsonc": ["biome:lint", "biome:check",[ "biome:format", "prettier"]],
    "julia": ["runic", "juliaformatter.jl"],
    "python": [ "ruff:format" ],
    "shell": [
      [
        "shfmt",
        "beautysh"
      ]
    ],
    "sql": [
      [
        "sqlfluff:fix",
        "sqlfluff:lint",
        "sqlfluff:format",
        "sqruff",
        "sql-formatter",
        "sqlint",
        "sqlfmt",
        "sleek"
      ]
    ],
    "*": ["typos"]
  }
}
